{$CADDY_HOST} {
    root * /srv

    # Proxy API calls to the palladium-stack dashboard (Flask, port set via API_PORT)
    handle /api/* {
        request_header X-API-Key {$API_KEY}
        reverse_proxy palladium-dashboard:{$API_PORT:8080}
    }

    file_server

    # Gzip/encoding
    encode zstd gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Disable persistent cache for dynamically loaded components
    header /navbar.html Cache-Control "no-store"
    header /footer.html Cache-Control "no-store"
    header /css/* Cache-Control "no-store"
    header /pool-data/* Cache-Control "no-store"

    # Exceptions: these two are vendored/rarely-changed CSS already served with a
    # ?v= cache-busting query string, so they're safe to cache aggressively instead
    # of re-downloading in full (mystyles.css alone is ~490KB) on every navigation.
    # Must come after the /css/* rule above so it wins for these two paths.
    header /css/mystyles.css Cache-Control "public, max-age=31536000, immutable"
    header /css/footer.css Cache-Control "public, max-age=31536000, immutable"

    # Handle .well-known and static assets normally (root covers everything)
}

www.{$CADDY_HOST} {
	redir https://{$CADDY_HOST}{uri}
}
